HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:4173

# Keep mock enabled until you intentionally test Resend.
EMAIL_PROVIDER=mock
RESEND_API_KEY=replace_with_your_backend_only_resend_api_key
# EMAIL_API_KEY remains supported for existing Phase B local configuration.
RESEND_REQUEST_TIMEOUT_MS=10000

CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000
